# 必需
PRIVATE_KEY=                # 热钱包私钥（无前缀 0x）
BSC_RPC_URL=https://bsc-dataseed.binance.org

# 可选（推荐）
PRIVATE_RPC_URL=            # 私有 RPC（MEV 保护）
BSCSCAN_API_KEY=            # BscScan API Key（合约验证）

# 通知
TELEGRAM_BOT_TOKEN=         # Telegram 通知机器人 Token
TELEGRAM_CHAT_ID=           # Telegram 通知 Chat ID

# 安全参数
MAX_SINGLE_TX_BNB=1.0
MAX_DAILY_SPEND_BNB=5.0
MAX_SLIPPAGE_BPS=100
MAX_CONSECUTIVE_FAILURES=3
MAX_HOURLY_LOSS_PCT=0.05
MAX_DAILY_LOSS_PCT=0.10

# 套利参数
MIN_PROFIT_BPS=50           # 最小利润基点（0.5%）
SCAN_INTERVAL_MS=3000       # 扫描间隔（毫秒）
GAS_PRICE_GWEI=5            # Gas 价格（Gwei）
GAS_LIMIT=500000            # Gas 限制

# 调试
LOG_LEVEL=info              # debug | info | warn | error
NODE_ENV=production
