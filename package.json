{
  "name": "bsc-arbitrage-bot",
  "version": "1.0.0",
  "description": "BSC链上自动套利机器人 - 监控多个DEX价格差异并自动执行套利交易",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "compile": "hardhat compile",
    "deploy": "hardhat run scripts/deploy.ts --network bsc",
    "verify": "hardhat run scripts/verify.ts --network bsc"
  },
  "keywords": [
    "bsc",
    "arbitrage",
    "defi",
    "bot",
    "pancakeswap",
    "biswap",
    "flash-loan"
  ],
  "author": "BalanceAiCoding",
  "license": "MIT",
  "dependencies": {
    "ethers": "^6.13.0",
    "dotenv": "^16.4.0",
    "winston": "^3.13.0",
    "node-cron": "^3.0.3",
    "axios": "^1.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/jest": "^29.5.0",
    "@types/node-cron": "^3.0.11",
    "typescript": "^5.5.0",
    "ts-node": "^10.9.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "hardhat": "^2.22.0",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@typechain/hardhat": "^9.0.0",
    "typechain": "^8.3.0",
    "@typechain/ethers-v6": "^0.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
